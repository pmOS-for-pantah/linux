/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>
#include <dt-bindings/usb/pd.h>
#include "gs101-pinctrl.h"
#include "gs201-pixel-common.dtsi"

/ {
	model = "Panther";
	compatible = "google,gs201-panther", "google,gs201";

	/*
	 * The bootloader picks the base DTB whose soc_id matches the product
	 * id (0x09855000) ORed with the major revision of the chip. Retail
	 * units are B0, which is revision 1.
	 */
	soc_id = <0x09855001 0x0>;

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa10 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa8 5 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <&nvmem_reboot_mode>;
		nvmem-cell-names = "reboot-mode";
		mode-bootloader = <0x800000fc>;
		mode-charge = <0x8000000a>;
		mode-dm-verity-device-corrupted = <0x80000050>;
		mode-fastboot = <0x800000fa>;
		mode-reboot-ab-update = <0x80000052>;
		mode-recovery = <0x800000ff>;
		mode-rescue = <0x800000f9>;
		mode-shutdown-thermal = <0x80000051>;
		mode-shutdown-thermal-battery = <0x80000051>;
	};
};

&acpm_ipc {
	pmic-1 {
		regulators {
			tsp_dvdd: ldo25m {
				regulator-name = "tsp_dvdd";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
			};

			ts_avdd: ldo26m {
				regulator-name = "ts_avdd";
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <3000000>;
			};
		};
	};
};

&cont_splash_mem {
	reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;

	status = "okay";
};

&framebuffer0 {
	width = <1080>;
	height = <2400>;
	stride = <(1080 * 4)>;
	format = "a8r8g8b8";

	status = "okay";
};

&pinctrl_far_alive {
	key_volup: key-volup-pins {
		samsung,pins = "gpa8-5";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	ts_irq: ts-irq-pins {
		samsung,pins = "gpa7-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_gpio_alive {
	key_voldown: key-voldown-pins {
		samsung,pins = "gpa10-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	typec_int: typec-int-pins {
		samsung,pins = "gpa9-7";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	if_pmic_int: if-pmic-int-pins {
		samsung,pins = "gpa9-4";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&hsi2c_13 {
	status = "okay";

	usb-typec@25 {
		compatible = "maxim,max77759-tcpci", "maxim,max33359";
		reg = <0x25>;
		interrupts-extended = <&gpa9 7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&typec_int>;
		pinctrl-names = "default";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			self-powered;
			try-power-role = "sink";
			op-sink-microwatt = <2600000>;
			source-pdos = <PDO_FIXED(5000, 900,
						 (PDO_FIXED_SUSPEND
						  | PDO_FIXED_USB_COMM
						  | PDO_FIXED_DATA_SWAP
						  | PDO_FIXED_DUAL_ROLE))>;
			sink-pdos = <PDO_FIXED(5000, 3000,
					       (PDO_FIXED_DATA_SWAP
						| PDO_FIXED_USB_COMM
						| PDO_FIXED_HIGHER_CAP
						| PDO_FIXED_DUAL_ROLE))
				     PDO_FIXED(9000, 2200, 0)>;
			pd-disable;
			typec-power-opmode = "default";
		};
	};

	pmic@66 {
		compatible = "maxim,max77759";
		reg = <0x66>;
		interrupts-extended = <&gpa9 4 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_int>;
		pinctrl-names = "default";
		interrupt-controller;
		#interrupt-cells = <2>;

		gpio {
			compatible = "maxim,max77759-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		nvmem-0 {
			compatible = "maxim,max77759-nvmem";

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				nvmem_reboot_mode: reboot-mode@0 {
					reg = <0x0 0x4>;
				};

				boot-reason@4 {
					reg = <0x4 0x4>;
				};

				shutdown-user-flag@8 {
					reg = <0x8 0x1>;
				};

				rsoc@a {
					reg = <0xa 0x2>;
				};
			};
		};
	};
};

&pinctrl_hsi1 {
	/*
	 * The touchscreen SPI bus is shared with the AoC, which takes it while
	 * this line is high. Keep the bus on the AP side.
	 */
	ts_spi_sel: ts-spi-sel-pins {
		samsung,pins = "gph1-0";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-val = <0>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_peric1 {
	ts_reset: ts-reset-pins {
		samsung,pins = "gpp23-2";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&spi_0 {
	cs-gpios = <&gpp20 3 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi0_bus &spi0_cs_func>;

	status = "okay";

	touchscreen@0 {
		compatible = "focaltech,ft3658";
		reg = <0>;
		spi-max-frequency = <10000000>;
		interrupt-parent = <&gpa7>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-0 = <&ts_irq &ts_reset &ts_spi_sel>;
		pinctrl-names = "default";
		reset-gpios = <&gpp23 2 GPIO_ACTIVE_LOW>;
		avdd-supply = <&ts_avdd>;
		vdd-supply = <&tsp_dvdd>;
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};

&usi13 {
	samsung,mode = <USI_MODE_I2C>;

	status = "okay";
};

&usi0 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};
