/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>
#include <dt-bindings/usb/pd.h>
#include "gs101-pinctrl.h"
#include "gs201-pixel-common.dtsi"

/ {
	model = "Panther";
	compatible = "google,gs201-panther", "google,gs201";

	/*
	 * The bootloader picks the base DTB whose soc_id matches the product
	 * id (0x09855000) ORed with the major revision of the chip. Retail
	 * units are B0, which is revision 1.
	 */
	soc_id = <0x09855001 0x0>;

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa10 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa8 5 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa10 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <&nvmem_reboot_mode>;
		nvmem-cell-names = "reboot-mode";
		mode-bootloader = <0x800000fc>;
		mode-charge = <0x8000000a>;
		mode-dm-verity-device-corrupted = <0x80000050>;
		mode-fastboot = <0x800000fa>;
		mode-reboot-ab-update = <0x80000052>;
		mode-recovery = <0x800000ff>;
		mode-rescue = <0x800000f9>;
		mode-shutdown-thermal = <0x80000051>;
		mode-shutdown-thermal-battery = <0x80000051>;
	};

	/*
	 * TODO: This is BUCKA of the S2MPG13 sub-PMIC, which stays on and is
	 * not driven by Linux yet.
	 */
	panel_vddi: regulator-panel-vddi {
		compatible = "regulator-fixed";
		regulator-name = "panel_vddi";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	wlan_pwr: regulator-wlan {
		compatible = "regulator-fixed";
		regulator-name = "wlan-reg-on";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gph2 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <200000>;
		pinctrl-0 = <&wlan_reg_on>;
		pinctrl-names = "default";
	};

	cp-shmem {
		compatible = "samsung,exynos-cp-shmem";
		cp_num = <0>;
		use_mem_map_on_cp = <0>;
		regions {
			ipc {
				region,name = "IPC";
				region,index = <3>;
				region,rmem = <0>;
				region,offset = <0>;
				region,size = <0x800000>;
				region,cached = <1>;
			};

			msi {
				region,name = "MSI";
				region,index = <11>;
				region,rmem = <1>;
				region,offset = <0>;
				region,size = <0x1000>;
				region,cached = <0>;
			};

			pktproc {
				region,name = "PKTPROC";
				region,index = <7>;
				region,rmem = <2>;
				region,offset = <0>;
				region,size = <0x1c00000>;
			};

			pktproc-ul {
				region,name = "PKTPROC_UL";
				region,index = <8>;
				region,rmem = <2>;
				region,offset = <0x1c00000>;
				region,size = <0x400000>;
			};
		};
	};

	cpif {
		compatible = "samsung,exynos-cp";
		pci_ch_num = <0>;
		pci_db_addr = <0x14e60000>;
		mif,name = "s5300";
		mif,cp_num = <0>;
		mif,modem_type = <1>;
		mif,protocol = <1>;
		mif,ipc_version = <0x32>;
		mif,link_type = <1>;
		mif,link_name = "PCIE";
		mif,link_attrs = <0x17c8>;
		mif,interrupt_types = <1>;
		mif,capability_check = <1>;
		mif,int_ap2cp_msg = <0>;
		mif,int_ap2cp_wakeup = <1>;
		mif,int_ap2cp_status = <2>;
		mif,int_ap2cp_active = <3>;
		mif,int_ap2cp_lcd_status = <4>;
		mif,int_ap2cp_pcie_link_ack = <14>;
		mif,int_ap2cp_uart_noti = <15>;
		mif,irq_cp2ap_msg = <0>;
		mif,irq_cp2ap_status = <2>;
		mif,irq_cp2ap_active = <3>;
		mif,irq_cp2ap_wakelock = <8>;
		mif,irq_cp2ap_ratmode = <9>;
		mif,cp2ap_active_not_alive = <0>;
		legacy_fmt_head_tail_offset = <0x8>;
		legacy_fmt_buffer_offset = <0x1000>;
		legacy_fmt_txq_size = <0x1000>;
		legacy_fmt_rxq_size = <0x1000>;
		legacy_raw_head_tail_offset = <0x18>;
		legacy_raw_buffer_offset = <0x3000>;
		legacy_raw_txq_size = <0x1fd000>;
		legacy_raw_rxq_size = <0x200000>;
		legacy_raw_rx_buffer_cached = <0>;
		offset_srinfo_offset = <0x64>;
		offset_capability_offset = <0x70>;
		offset_boot_indicator = <0x90>;
		srinfo_offset = <0x400000>;
		srinfo_size = <0x300000>;
		capability_offset = <0xa0>;
		ap_capability_0 = <0>;
		ap_capability_1 = <0>;
		ap2cp_msg = <2 0x800>;
		cp2ap_msg = <2 0x804>;
		ap2cp_united_status = <2 0x808>;
		cp2ap_united_status = <2 0x80c>;
		ap2cp_kerneltime = <2 0x824>;
		ap2cp_handover_block_info = <2 0x82c>;
		sbi_lcd_status_mask = <0x1>;
		sbi_lcd_status_pos = <27>;
		sbi_crash_type_mask = <0xf>;
		sbi_crash_type_pos = <23>;
		sbi_uart_noti_mask = <0x1>;
		sbi_uart_noti_pos = <16>;
		sbi_ds_det_mask = <0x3>;
		sbi_ds_det_pos = <14>;
		sbi_pda_active_mask = <0x1>;
		sbi_pda_active_pos = <5>;
		sbi_ap_status_mask = <0xf>;
		sbi_ap_status_pos = <1>;
		sbi_cp_rat_mode_mask = <0x3f>;
		sbi_cp_rat_mode_pos = <26>;
		sbi_cp2ap_wakelock_mask = <0x1>;
		sbi_cp2ap_wakelock_pos = <6>;
		sbi_lte_active_mask = <0x1>;
		sbi_lte_active_pos = <5>;
		sbi_cp_status_mask = <0xf>;
		sbi_cp_status_pos = <1>;
		sbi_ap2cp_kerneltime_sec_mask = <0xfff>;
		sbi_ap2cp_kerneltime_sec_pos = <20>;
		sbi_ap2cp_kerneltime_usec_mask = <0xfffff>;
		sbi_ap2cp_kerneltime_usec_pos = <0>;
		pktproc_use_36bit_addr = <0>;
		pktproc_cp_base = <0x0 0x20000000>;

		pktproc_dl_support = <1>;
		pktproc_dl_version = <2>;
		pktproc_dl_info_rgn_offset = <0x0>;
		pktproc_dl_info_rgn_size = <0x1000>;
		pktproc_dl_desc_rgn_offset = <0x1000>;
		pktproc_dl_desc_rgn_size = <0xff000>;
		pktproc_dl_buff_rgn_offset = <0x100000>;
		pktproc_dl_buff_rgn_size = <0x1b00000>;
		pktproc_dl_info_rgn_cached = <1>;
		pktproc_dl_desc_rgn_cached = <1>;
		pktproc_dl_buff_rgn_cached = <1>;
		pktproc_dl_desc_mode = <1>;
		pktproc_dl_num_queue = <4>;
		pktproc_dl_use_exclusive_irq = <1>;
		pktproc_dl_use_hw_iocc = <1>;
		pktproc_dl_max_packet_size = <0x630>;
		pktproc_dl_use_dedicated_baaw = <0>;

		pktproc_ul_support = <1>;
		pktproc_ul_info_rgn_offset = <0x1c00000>;
		pktproc_ul_info_rgn_size = <0x1000>;
		pktproc_ul_desc_rgn_offset = <0x1c01000>;
		pktproc_ul_desc_rgn_size = <0x8f000>;
		pktproc_ul_buff_rgn_offset = <0x1c90000>;
		pktproc_ul_buff_rgn_size = <0x370000>;
		pktproc_ul_padding_required = <1>;
		pktproc_ul_num_queue = <2>;
		pktproc_ul_max_packet_size = <0x800>;
		pktproc_ul_hiprio_ack_only = <1>;
		pktproc_ul_info_rgn_cached = <1>;
		pktproc_ul_desc_rgn_cached = <1>;
		pktproc_ul_buff_rgn_cached = <1>;
		pktproc_ul_use_hw_iocc = <1>;

		iodevs {
			io_device_0 {
				iod,name = "umts_ipc";
				iod,ch = <0xf5>;
				iod,format = <0>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0x2000>;
				iod,ch_count = <2>;
			};

			io_device_1 {
				iod,name = "umts_rfs0";
				iod,ch = <0x29>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_2 {
				iod,name = "umts_router";
				iod,ch = <0x15>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_3 {
				iod,name = "umts_dm0";
				iod,ch = <0x51>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0x4000>;
			};

			io_device_4 {
				iod,name = "umts_loopback";
				iod,ch = <0x52>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_5 {
				iod,name = "rmnet";
				iod,ch = <0xb5>;
				iod,format = <1>;
				iod,io_type = <2>;
				iod,link_type = <1>;
				iod,attrs = <0x2000>;
				iod,ch_count = <30>;
			};

			io_device_6 {
				iod,name = "umts_dummy";
				iod,ch = <0xd3>;
				iod,format = <1>;
				iod,io_type = <2>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_7 {
				iod,name = "multipdp";
				iod,ch = <0>;
				iod,format = <3>;
				iod,io_type = <3>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_8 {
				iod,name = "umts_boot0";
				iod,ch = <0xf1>;
				iod,format = <4>;
				iod,io_type = <0>;
				iod,link_type = <1>;
				iod,attrs = <0x200>;
			};

			io_device_9 {
				iod,name = "umts_rcs0";
				iod,ch = <0x5b>;
				iod,format = <0>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_10 {
				iod,name = "umts_rcs1";
				iod,ch = <0x5c>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_11 {
				iod,name = "umts_wfc0";
				iod,ch = <0x5d>;
				iod,format = <0>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_12 {
				iod,name = "umts_wfc1";
				iod,ch = <0x5e>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};

			io_device_13 {
				iod,name = "oem_ipc";
				iod,ch = <0x81>;
				iod,format = <0>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0x2000>;
				iod,ch_count = <8>;
			};

			io_device_14 {
				iod,name = "oem_test";
				iod,ch = <0x89>;
				iod,format = <1>;
				iod,io_type = <1>;
				iod,link_type = <1>;
				iod,attrs = <0>;
			};
		};
	};
};

&acpm_ipc {
	pmic-1 {
		regulators {
			tsp_dvdd: ldo25m {
				regulator-name = "tsp_dvdd";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
			};

			ts_avdd: ldo26m {
				regulator-name = "ts_avdd";
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <3000000>;
			};

			panel_vci: ldo27m {
				regulator-name = "panel_vci";
				regulator-min-microvolt = <3025000>;
				regulator-max-microvolt = <3025000>;
			};
		};
	};
};

&cont_splash_mem {
	reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;

	status = "okay";
};

&decon {
	status = "okay";
};

&dsim {
	status = "okay";

	panel@0 {
		compatible = "samsung,s6e3fc3-p10", "samsung,s6e3fc3";
		reg = <0>;

		reset-gpios = <&gpa7 1 GPIO_ACTIVE_LOW>;
		vci-supply = <&panel_vci>;
		vddi-supply = <&panel_vddi>;
	};
};

&framebuffer0 {
	width = <1080>;
	height = <2400>;
	stride = <(1080 * 4)>;
	format = "a8r8g8b8";

	status = "okay";
};

&pcie_0 {
	status = "okay";

	modem {
		compatible = "samsung,s5300-modem";
		memory-region = <&cp_rmem>, <&cp_msi_rmem>, <&cp_rmem1>;
		ap2cp-pda-active-gpios = <&gph1 1 GPIO_ACTIVE_HIGH>;
		ap2cp-cp-pwr-on-gpios = <&gph1 2 GPIO_ACTIVE_HIGH>;
		ap2cp-nreset-gpios = <&gph1 3 GPIO_ACTIVE_HIGH>;
		ap2cp-cp-wrst-gpios = <&gph1 6 GPIO_ACTIVE_HIGH>;
		ap2cp-pm-wrst-gpios = <&gpa0 3 GPIO_ACTIVE_HIGH>;
		ap2cp-wakeup-gpios = <&gph0 2 GPIO_ACTIVE_HIGH>;
		ap2cp-dump-noti-gpios = <&gph0 3 GPIO_ACTIVE_HIGH>;
		cp2ap-cp-wrst-gpios = <&gpa0 2 GPIO_ACTIVE_HIGH>;
		cp2ap-ps-hold-gpios = <&gpa8 2 GPIO_ACTIVE_HIGH>;
		cp2ap-wakeup-gpios = <&gpa8 3 GPIO_ACTIVE_HIGH>;
		cp2ap-phone-active-gpios = <&gpa8 4 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};
};

&pcie_0_phy {
	status = "okay";
};

&pcie_1 {
	pinctrl-0 = <&pcie1_clkreq>, <&pcie1_perst>, <&wlan_dev_wake>,
		    <&wlan_host_wake>;
	pinctrl-names = "default";

	status = "okay";

	pcie@0,0 {
		compatible = "pciclass,0604";
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		bus-range = <0x01 0xff>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		vpcie3v3-supply = <&wlan_pwr>;

		wifi@0,0 {
			compatible = "pci14e4,4441";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			brcm,board-type = "google,gs201-panther";
			memory-region = <&wifi_dma_pool>;
		};
	};
};

&pcie_1_phy {
	status = "okay";
};

&pinctrl_far_alive {
	hapt_amp_irq: hapt-amp-irq-pins {
		samsung,pins = "gpa8-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	bt_host_wake: bt-host-wake-pins {
		samsung,pins = "gpa6-6";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	key_volup: key-volup-pins {
		samsung,pins = "gpa8-5";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	ts_irq: ts-irq-pins {
		samsung,pins = "gpa7-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
	wlan_host_wake: wlan-host-wake-pins {
		samsung,pins = "gpa6-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

};

&pinctrl_gpio_alive {
	key_power: key-power-pins {
		samsung,pins = "gpa10-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa10-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	typec_int: typec-int-pins {
		samsung,pins = "gpa9-7";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	if_pmic_int: if-pmic-int-pins {
		samsung,pins = "gpa9-4";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	if_pmic_fg_int: if-pmic-fg-int-pins {
		samsung,pins = "gpa9-3";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&hsi2c_8 {
	clock-frequency = <400000>;

	status = "okay";

	haptics: haptic-driver@43 {
		compatible = "cirrus,cs40l26a";
		reg = <0x43>;
		interrupts-extended = <&gpa8 1 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp24 3 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&hapt_amp_irq>, <&hapt_amp_rst>;
		pinctrl-names = "default";
		cirrus,boost-peak-microamp = <2500000>;
		cirrus,boost-ctl-microvolt = <11000000>;
		cirrus,vpbr-threshold-microvolt = <3008000>;
		cirrus,lra-f0-hz = <145>;
		cirrus,lra-redc-micro-ohms = <13000000>;
	};
};

&hsi2c_15 {
	status = "okay";

	led-controller@63 {
		compatible = "ti,lm3644";
		reg = <0x63>;
		enable-gpios = <&gpp8 2 GPIO_ACTIVE_HIGH>;

		led {
			function = LED_FUNCTION_FLASH;
			color = <LED_COLOR_ID_WHITE>;
			led-sources = <1>, <2>;
			led-max-microamp = <89300>;
			flash-max-microamp = <729000>;
			flash-max-timeout-us = <400000>;
		};
	};
};

&hsi2c_13 {
	status = "okay";

	usb-typec@25 {
		compatible = "maxim,max77759-tcpci", "maxim,max33359";
		reg = <0x25>;
		interrupts-extended = <&gpa9 7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&typec_int>;
		pinctrl-names = "default";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			self-powered;
			try-power-role = "sink";
			op-sink-microwatt = <2600000>;
			source-pdos = <PDO_FIXED(5000, 900,
						 (PDO_FIXED_SUSPEND
						  | PDO_FIXED_USB_COMM
						  | PDO_FIXED_DATA_SWAP
						  | PDO_FIXED_DUAL_ROLE))>;
			sink-pdos = <PDO_FIXED(5000, 3000,
					       (PDO_FIXED_DATA_SWAP
						| PDO_FIXED_USB_COMM
						| PDO_FIXED_HIGHER_CAP
						| PDO_FIXED_DUAL_ROLE))
				     PDO_FIXED(9000, 2200, 0)>;
			typec-power-opmode = "default";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					usbc0_orien_sw: endpoint {
						remote-endpoint = <&usbdrd31_phy_orien_switch>;
					};
				};

				port@1 {
					reg = <1>;

					usbc0_role_sw: endpoint {
						remote-endpoint = <&usbdrd31_dwc3_role_switch>;
					};
				};
			};
		};
	};

	fuel-gauge@36 {
		compatible = "maxim,max77759-fg";
		reg = <0x36>;
		interrupts-extended = <&gpa9 3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_fg_int>;
		pinctrl-names = "default";
		shunt-resistor-micro-ohms = <5000>;
	};

	pmic@66 {
		compatible = "maxim,max77759";
		reg = <0x66>;
		interrupts-extended = <&gpa9 4 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&if_pmic_int>;
		pinctrl-names = "default";
		interrupt-controller;
		#interrupt-cells = <2>;

		gpio {
			compatible = "maxim,max77759-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		nvmem-0 {
			compatible = "maxim,max77759-nvmem";

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				nvmem_reboot_mode: reboot-mode@0 {
					reg = <0x0 0x4>;
				};

				boot-reason@4 {
					reg = <0x4 0x4>;
				};

				shutdown-user-flag@8 {
					reg = <0x8 0x1>;
				};

				rsoc@a {
					reg = <0xa 0x2>;
				};
			};
		};
	};
};

&pinctrl_hsi2 {
	wlan_reg_on: wlan-reg-on-pins {
		samsung,pins = "gph2-4";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_NONE>;
	};

	wlan_dev_wake: wlan-dev-wake-pins {
		samsung,pins = "gph2-5";
		samsung,pin-function = <GS101_PIN_FUNC_INPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
		samsung,pin-con-pdn = <GS101_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <GS101_PIN_PULL_DOWN>;
	};
};

&pinctrl_hsi1 {
	/*
	 * The touchscreen SPI bus is shared with the AoC, which takes it while
	 * this line is high. Keep the bus on the AP side.
	 */
	ts_spi_sel: ts-spi-sel-pins {
		samsung,pins = "gph1-0";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-val = <0>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_peric0 {
	bt_reg_on: bt-reg-on-pins {
		samsung,pins = "gpp16-2";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	bt_dev_wake: bt-dev-wake-pins {
		samsung,pins = "gpp16-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_peric1 {
	hapt_amp_rst: hapt-amp-rst-pins {
		samsung,pins = "gpp24-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	ts_reset: ts-reset-pins {
		samsung,pins = "gpp23-2";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&reserved_memory {
	linux,cma {
		compatible = "shared-dma-pool";
		reusable;
		size = <0x10000000>;
		/* DPP DMA addresses are 32 bits wide */
		alloc-ranges = <0x0 0x80000000 0x80000000>;
		linux,cma-default;
	};
	wifi_dma_pool: wifi-dma-pool {
		compatible = "restricted-dma-pool";
		size = <0x1000000>;
		alignment = <0x0 0x200000>;
		alloc-ranges = <0x0 0x80000000 0x80000000>;
	};

};

&serial_apm1 {
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4389-bt";
		shutdown-gpios = <&gpp16 2 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpp16 3 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpa6 6 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "host-wakeup";
		pinctrl-0 = <&bt_reg_on &bt_dev_wake &bt_host_wake>;
		pinctrl-names = "default";
		max-speed = <3000000>;
	};
};

&spi_0 {
	cs-gpios = <&gpp20 3 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi0_bus &spi0_cs_func>;

	status = "okay";

	touchscreen@0 {
		compatible = "focaltech,ft3658";
		reg = <0>;
		spi-max-frequency = <10000000>;
		interrupt-parent = <&gpa7>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-0 = <&ts_irq &ts_reset &ts_spi_sel>;
		pinctrl-names = "default";
		reset-gpios = <&gpp23 2 GPIO_ACTIVE_LOW>;
		avdd-supply = <&ts_avdd>;
		vdd-supply = <&tsp_dvdd>;
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};

&usi8 {
	samsung,mode = <USI_MODE_I2C>;

	status = "okay";
};

&usi13 {
	samsung,mode = <USI_MODE_I2C>;

	status = "okay";
};

&usi15 {
	samsung,mode = <USI_MODE_I2C>;

	status = "okay";
};

&usi0 {
	samsung,mode = <USI_MODE_SPI>;

	status = "okay";
};

&usi_apm1 {
	samsung,mode = <USI_MODE_UART>;

	status = "okay";
};

&usbdrd31_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "peripheral";

	port {
		usbdrd31_dwc3_role_switch: endpoint {
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&usbdrd31_phy {
	orientation-switch;

	port {
		usbdrd31_phy_orien_switch: endpoint {
			remote-endpoint = <&usbc0_orien_sw>;
		};
	};
};
